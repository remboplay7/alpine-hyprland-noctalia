# Contributor: Zach DeCook <zachdecook@librem.one>
maintainer="Zach DeCook <zachdecook@librem.one>"
pkgname=aquamarine
pkgver=0.15.1
pkgrel=1
pkgdesc="Aquamarine is a very light linux rendering backend library"
url="https://github.com/hyprwm/aquamarine"
arch="all"
license="BSD-3-Clause"

	source="$pkgname-$pkgver.tar.gz::https://github.com/hyprwm/aquamarine/archive/refs/tags/v$pkgver.tar.gz"
	
makedepends="
	cmake
	eudev-dev
	hwdata-dev
	hyprutils-dev>=0.14.0
	hyprwayland-scanner>=0.4.0
	libdisplay-info-dev
	libinput-dev
	libseat-dev
	mesa-dev
	samurai
	pixman-dev
	wayland-dev
	wayland-protocols
	"
subpackages="$pkgname-doc $pkgname-dev"
options="!check" # tests are broken

prepare() {
	default_prepare
	sed -i -e "s/OpenGL::OpenGL/OpenGL::GL/" "$builddir/CMakeLists.txt"
}

build() {
	cmake -B build -G Ninja \
		-DCMAKE_INSTALL_PREFIX=/usr \
		-DCMAKE_INSTALL_LIBDIR=lib \
		-DCMAKE_BUILD_TYPE=None
	cmake --build build
}

check() {
	cd build
	ctest
}

package() {
	DESTDIR="$pkgdir" cmake --install build
	install -Dm644 LICENSE "$pkgdir"/usr/share/licenses/$pkgname/LICENSE
}



sha512sums="
427bf1b416a4fad8fdbb60c6e55d89da71cfbc56700ad3ae1806c87af1ab9790bb38efd70711025937e35c4d092602a43ff265b80cf78b062ef3b081b9bb834d  aquamarine-0.15.1.tar.gz
"
