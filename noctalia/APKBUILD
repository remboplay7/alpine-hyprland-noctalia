#subpackages="$pkgname-doc"

#_stb_commit="5736b15f7ea0ff732947211128b389d01b51e4bf"

source="$pkgname-$pkgver.tar.gz::https://github.com/noctalia-dev/noctalia/archive/refs/tags/v$pkgver.tar.gz
				stb-master.tar.gz::https://github.com/nothings/stb/archive/refs/heads/master.tar.gz"

prepare() {
	default_prepare

	mkdir -p "$builddir"/include/stb
	cp "$srcdir"/stb-master/*.h "$builddir"/include/stb/
}

build() {
	abuild-meson \
		-Dc_args="-I$builddir/include" \
		-Dcpp_args="-I$builddir/include" \
		-Dtests=disabled \
		. output
	meson compile -C output
}
check() {
	# Тесты в релизных тарболах часто требуют рабочий Wayland-сокет
	meson test -C output --no-rebuild --print-errorlogs || true
}

package() {
	DESTDIR="$pkgdir" meson install --no-rebuild -C output
}
