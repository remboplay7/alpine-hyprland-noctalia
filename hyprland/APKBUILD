	jq
	libdrm-dev
	libinput-dev
	libliftoff-dev
	libxcb-dev
	libxcursor-dev
	libxkbcommon-dev
	mesa-dev
	muparser-dev
	pango-dev
	pixman-dev
	re2-dev
	samurai
	tomlplusplus-dev
